{
  "name": "cursor-template-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,less,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,less,json}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "antd": "^6.3.5",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.46.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.30.3",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "less": "^4.3.0",
    "oxlint": "^1.2.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vite-plugin-svgr": "^5.2.0"
  }
